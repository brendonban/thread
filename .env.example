# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=        # a long random string: openssl rand -base64 32
NEXTAUTH_URL=           # https://your-domain (http://localhost:3000 locally)

# Site owners (always have access). Add Admins and Editors from Admin → Access.
ADMIN_EMAILS=you@example.com

# GitHub: admin saves commit to this repository
GITHUB_TOKEN=           # fine-grained token, this repo only, Contents: Read and write
GITHUB_REPO=            # owner/name
GITHUB_BRANCH=main

# Optional: keep research resources in a separate private repository
# RESOURCES_REPO=owner/name
# RESOURCES_BRANCH=main
